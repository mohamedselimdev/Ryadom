NODE_ENV=development
PORT=5000

# Database: "postgres" (default) or "sqlite" for quick local runs without PostgreSQL
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ryadom_db
DB_USER=postgres
DB_PASSWORD=
# Used only when DB_DIALECT=sqlite
DB_STORAGE=data/ryadom.sqlite

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Comma-separated origins allowed to call the API from another domain (leave empty when frontend is served by this server)
CORS_ORIGIN=

# Optional Python text-generation service (ai/model_server.py). Empty = built-in keyword bot.
AI_SERVICE_URL=
